  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@contentbuilder/shared": "*",
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ffmpeg-static": "^5.3.0",
    "image-size": "^2.0.2",
    "mongoose": "^8.8.1",
    "multer": "^2.2.0",
    "node-vibrant": "^4.0.4",
    "puppeteer": "^25.2.1",
    "sharp": "^0.35.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
