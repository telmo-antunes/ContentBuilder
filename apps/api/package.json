{
  "name": "@contentbuilder/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "seed": "tsx src/seed.ts",
    "eval:compose": "tsx src/eval/run.ts",
    "migrate:photos": "tsx src/scripts/migrateSlidePhotos.ts",
    "migrate:media-urls": "tsx src/scripts/migrateMediaUrls.ts",
    "typecheck": "tsc --noEmit",
    "migrate:recipes": "tsx src/scripts/migrateRecipeGates.ts",
    "prompt:hashes": "tsx src/scripts/promptHashes.ts",
    "media:orphans": "tsx src/scripts/sweepOrphanedMedia.ts",
    "scaffolds:orphans": "tsx src/scripts/sweepRenderScaffolds.ts",
    "layout:corpus": "tsx src/scripts/slackDistribution.ts",
    "ai:share": "tsx src/scripts/aiShare.ts",
    "fragments:carry": "tsx src/scripts/carryFragments.ts",
