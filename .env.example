# ── Database ─────────────────────────────────────────────────────────────────
# Any MongoDB works; `npm run dev` starts a bundled local mongod on this port.
MONGODB_URI=mongodb://127.0.0.1:27017/contentbuilder

# ── Service URLs / ports ─────────────────────────────────────────────────────
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Optional override for the browser bundle. Normally leave unset: the browser
# calls the same-origin /api proxy, which Next rewrites to API_URL.
# NEXT_PUBLIC_API_URL=

# ── Auth (OPTIONAL) ──────────────────────────────────────────────────────────
# Shared password. When set it gates BOTH the web UI (Basic auth in
# apps/web/middleware.ts) AND the API (Basic auth in apps/api/src/app.ts;
# /health and media reads stay open). Leave empty for open local dev.
APP_PASSWORD=

# ── Storage ──────────────────────────────────────────────────────────────────
# Storage backend for uploads, harvested photos, renders, and video artifacts.
# `disk` is the only provider right now.
STORAGE_PROVIDER=disk
STORAGE_DIR=./storage

# ── AI (OPTIONAL) ────────────────────────────────────────────────────────────
# The app runs with all of these unset: website analysis falls back to
# heuristic colors, and the compose / recipe / caption features disable.
# Each touchpoint can also be overridden per-model from the Settings page.
# ANTHROPIC_API_KEY=
# Base tier — required for the brand-vision pass (with the key).
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Cheap tier — slide compose + variants; also the "AI configured" gate for
# compose and captions. Haiku-class.
# ANTHROPIC_MODEL_SMALL=claude-haiku-4-5-20251001
# Vision/judgment tier — brand vision, captions, photo fit. Sonnet-class.
# (Historical name: this is NOT a free tier.)
# ANTHROPIC_MODEL_FREE=claude-sonnet-4-6
# Design-critical tier — authoring the Brand Recipe (the once-per-brand design
# system). Opus-class recommended; falls back down the stack when unset.
# ANTHROPIC_MODEL_DESIGN=claude-opus-4-8

# ── Stock photos (OPTIONAL) ──────────────────────────────────────────────────
# Free key at https://www.pexels.com/api/ — enables the stock-photo search and
# picker in the Studio. Unset = the picker is disabled; uploads still work.
PEXELS_API_KEY=

# ── Development escape hatch ─────────────────────────────────────────────────
# Set to `true` to let analyze/harvest target private/localhost hosts (the
# SSRF guard refuses them by default). Development only.
# ALLOW_PRIVATE_URLS=true
